e\nprint(\"Year range:\", df[\"Year\"].min(), \"to\", df[\"Year\"].max())\n\n# Fix wrong year (this game was released in 2009)\ndf.loc[(df[\"Name\"] == \"Imagine: Makeup Artist\") & (df[\"Year\"] == 2020), \"Year\"] = 2009\n\n# Check platform and genre values\nprint(df[\"Platform\"].unique())\nprint(df[\"Genre\"].unique())\n\n# Check sales values\nsales = [\"NA_Sales\", \"EU_Sales\", \"JP_Sales\", \"Other_Sales\", \"Global_Sales\"]\nprint(\"Negative values:\", (df[sales] < 0).sum().sum())\n\n# Check regional sales add up to global sales\ndiff = (df[\"Global_Sales\"] - df[sales[:4]].sum(axis=1)).abs()\nprint(\"Max difference:\", round(diff.max(), 2))\n\nprint(df.isnull().sum())\nprint(\"Final shape:\", df.shape)\n\ndf.to_csv(\"vgsales_cleaned.csv\", index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T17:52:30.162934Z","iopub.execute_input":"2026-11-16T17:52:30.163255Z","iopub.status.idle":"2026-11-16T17:52:30.391032Z","shell.execute_reply.started":"2026-11-16T17:52:30.163227Z","shell.execute_reply":"2026-11-16T17:52:30.390146Z"}},"outputs":[{"name":"stdout","text":"Shape: (16598, 11)\n<class 'pandas.core.frame.DataFrame'>\nRangeIndex: 16598 entries, 0 to 16597\nData columns (total 11 columns):\n #   Column        Non-Null Count  Dtype  \n---  ------        --------------  -----  \n 0   Rank          16598 non-null  int64  \n 1   Name          16598 non-null  object \n 2   Platform      16598 non-null  object \n 3   Year          16327 non-null  float64\n 4   Genre         16598 non-null  object \n 5   Publisher     16540 non-null  object \n 6   NA_Sales      16598 non-null  float64\n 7   EU_Sales      16598 non-null  float64\n 8   JP_Sales      16598 non-null  float64\n 9   Other_Sales   16598 non-null  float64\n 10  Global_Sales  16598 non-null  float64\ndtypes: float64(6), int64(1), object(4)\nmemory usage: 1.4+ MB\nNone\nRank              0\nName              0\nPlatform          0\nYear            271\nGenre             0\nPublis